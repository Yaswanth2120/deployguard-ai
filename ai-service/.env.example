# OpenRouter API key for real model calls. Leave blank to use the heuristic analyzer.
OPENROUTER_API_KEY=

OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30

# Analysis mode: heuristic | single_shot | rag | agent (default rag).
ANALYSIS_MODE=rag

# Per-1k-token prices used for cost telemetry. 0 for free models.
LLM_PRICE_PER_1K_PROMPT_USD=0
LLM_PRICE_PER_1K_COMPLETION_USD=0

# Optional override for the trained risk model artifact.
# RISK_MODEL_PATH=ml_artifacts/risk_model.json

# Container platforms commonly provide PORT. Local development defaults to 8001.
PORT=8001
